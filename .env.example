DEBUG=true
SECRET_KEY=django-insecure-local-development-only-change-me
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000

POSTGRES_DB=bank
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
DB_CONN_MAX_AGE=60

REDIS_URL=redis://127.0.0.1:6380/0
CHANNEL_REDIS_URL=redis://127.0.0.1:6380/1

EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
CELERY_BROKER_URL=redis://127.0.0.1:6380/2
CELERY_RESULT_BACKEND=redis://127.0.0.1:6380/3
FRAUD_PROFILE_REDIS_URL=redis://127.0.0.1:6380/4
FRAUD_ALERT_EMAIL=fraud-ops@example.com

# kafka | inline (inline = no broker; handlers run in-process after commit)
EVENT_BUS=kafka
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9094

# Bank identity: seeds the back-office "Bank profile" on first use (edit it there afterwards).
BANK_NAME=Demo Bank
BANK_LEGAL_NOTICE=Registered in Kenya.
BANK_SUPPORT_EMAIL=support@example.com
BANK_SUPPORT_PHONE=+254 20 000 0000
# Fixed per deployment: amounts are stored without a currency.
BANK_CURRENCY=KES
TIME_ZONE=Africa/Nairobi
